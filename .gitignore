# ---- Data: downloaded or regenerated by the pipeline, never committed (~1.1 GB) ----
# Leading slash matters: a bare `data/` would also exclude the pcgate/data source package.
/data/
*.part

# ---- Results: keep the small tables the report cites, drop the bulk ----
/results/**
!/results/**/
!/results/**/summary.md
!/results/**/coverage.md
!/results/**/pool_diagnostic.md
!/results/**/dataset_report.md
!/results/**/all_runs.csv
!/results/**/coverage.csv
!/results/**/coverage_by_degree.csv
!/results/**/pool_diagnostic.csv
!/results/**/profile*.csv
!/results/**/metrics.json
# excluded by the rules above: model.pt (8 MB), candidates_*.csv (3 MB), run logs, history.csv

# ---- Build artefacts ----
pcgate_colab_bundle.zip
*_results.zip

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Virtual environments ----
.venv/
venv/
env/
.conda/

# ---- Jupyter / Colab ----
.ipynb_checkpoints/

# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Editors and OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
